{
  "name": "ai-clinic-backend",
  "version": "1.0.0",
  "description": "AI Clinic Management SaaS — Express/MongoDB backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
