# MongoDB connection string — get from MongoDB Atlas > Connect > Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai-clinic?retryWrites=true&w=majority

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_long_random_secret_here

# JWT expiry
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Environment
NODE_ENV=development

# Google Gemini AI — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# CORS — your frontend URL (localhost for dev, Vercel URL for production)
FRONTEND_ORIGIN=http://localhost:5173
